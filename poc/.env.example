# איך משתמשים: מעתיקים את הקובץ הזה לקובץ חדש בשם .env (באותה תיקייה) וממלאים מפתחות אחרי הסימן =
# הקובץ .env לא נכנס לגיט, כדי שמפתחות לא יתפרסמו בטעות. אין לשלוח מפתחות בצ'אט או במייל.

# מפתח Anthropic (Claude): console.anthropic.com
ANTHROPIC_API_KEY=

# מפתח Soniox (תמלול): console.soniox.com, בפרויקט תחת API Keys
SONIOX_API_KEY=

# אופציונלי: Deepgram יצא מהתכנון. נשאר רק להשוואה
# DEEPGRAM_API_KEY=

# אופציונלי: שינוי מודל או מאמץ של Claude
# LIVESCOPE_MODEL=claude-opus-5-5
# LIVESCOPE_EFFORT=low
